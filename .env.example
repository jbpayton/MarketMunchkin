ALPACA_API_KEY=your-key
ALPACA_SECRET_KEY=your-secret
ALPACA_PAPER=true
# Any OpenAI-compatible chat server with tool calling (LM Studio, Ollama, vLLM, OpenAI, OpenRouter...)
LLM_PROVIDER=lmstudio
LLM_BASE_URL=http://localhost:1234
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY=
SEARXNG_URL=http://127.0.0.1:8088

# Context window in tokens. Leave unset to auto-detect (LM Studio, Ollama, OpenRouter, vLLM); set it for servers that do not report one.
# LLM_CONTEXT_TOKENS=65536
